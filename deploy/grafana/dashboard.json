{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Output throughput",
      "targets": [{"expr": "rate(llm_output_tokens_total[1m])", "legendFormat": "tokens/s"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 time to first token",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(llm_time_to_first_token_seconds_bucket[5m])) by (le))", "legendFormat": "p95 TTFT"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Active requests",
      "targets": [{"expr": "llm_active_requests", "legendFormat": "active"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 request latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(llm_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95 e2e"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Request rate by status",
      "targets": [{"expr": "sum by (status) (rate(llm_requests_total[1m]))", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["llm", "inference"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
